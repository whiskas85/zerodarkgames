# Copia questo file in .env e personalizza i valori.

# Porta sul PC (http://localhost:8090)
ZDG_PORT=8090

# Utente MASTER (regia). Creato al primo avvio.
MASTER_USER=master
MASTER_PASSWORD=cambiami
# Metti 1 per reimpostare la password MASTER al prossimo avvio, poi rimetti 0.
MASTER_PASSWORD_RESET=0

# URL pubblico usato nei QR stampati (Altari e credenziali).
# Vuoto = l'indirizzo da cui apri la regia. Per i telefoni in rete locale usa l'IP del PC,
# es. http://192.168.1.50:8090 — in produzione l'HTTPS del dominio, es. https://giochi.zerodarkteam.it
PUBLIC_URL=

# Contatto richiesto dallo standard Web Push
VAPID_SUBJECT=mailto:consiglio@zerodarkteam.it
